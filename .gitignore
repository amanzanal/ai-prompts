# --- DATOS Y MODELOS (MLOps) ---
# Ignoramos los datos procesados y modelos pesados, pero mantenemos las carpetas con .gitkeep
data/processed/*
!data/processed/.gitkeep
models/*
!models/.gitkeep

# (Opcional) Si en algún momento manejas datos raw muy pesados, descomenta la siguiente línea:
# data/raw/*
# !data/raw/.gitkeep

# --- CONFIGURACIÓN Y CREDENCIALES ---
.env
*.env
.venv
venv.local

